# Print server (pnpm print-server). Leave PRINTER_NAME empty to use the CUPS default.
PRINT_SERVER_PORT=3847
PRINTER_NAME=
CUPS_MEDIA_OPTION=Postcard

# Home gallery on homeserver: the QR's first choice. Upload over the tailnet;
# the key is API_KEY in ~/photobooth/.env on homeserver. Leave empty to skip.
GALLERY_UPLOAD_URL=http://homeserver:8000
GALLERY_API_KEY=

# Vercel Blob (fallback when the gallery is unset or unreachable)
BLOB_READ_WRITE_TOKEN=

# Badge taps. CHALLENGE_ID is challenges.id.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
CHALLENGE_ID=
