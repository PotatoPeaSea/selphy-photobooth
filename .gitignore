# ---------------------------------------------------------------------------
# Secrets and environment files. Keep only the template, .env.example.
# (BLOB_READ_WRITE_TOKEN, DATABASE_URL, GALLERY_API_KEY, STAFF_PIN, ... live here.)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
!*.env.example
.envrc
.direnv/

