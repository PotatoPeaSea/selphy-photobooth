# ---------------------------------------------------------------------------
# Locally written runtime data
# lib/localShareStore.ts writes strips to ./.data/strips (share-link fallback).
# print-server/history.mjs (post-event-fixes branch) keeps print history in
# $PRINT_HISTORY_DIR, default ~/.cache/photobooth/prints.
# ---------------------------------------------------------------------------
.data
.data/
/data/
/uploads/
/tmp/
prints/
print-history/
history/
index.json.*.tmp

# ---------------------------------------------------------------------------
